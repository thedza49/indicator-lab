# Sovson Indicator Lab — Environment Variables
# Copy this file to .env and fill in your real values
# Never commit .env to GitHub

# Financial Modeling Prep API key (https://financialmodelingprep.com)
FMP_API_KEY=your_fmp_api_key_here

# How many days of price history to fetch on first run
INITIAL_HISTORY_DAYS=365

# Flask API settings
FLASK_PORT=5001
FLASK_HOST=0.0.0.0

# Optional: set to "true" to see verbose logging
DEBUG=false
